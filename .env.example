# Google OAuth — Web client ID from Google Cloud Console
# Client type MUST be "Web application" (not Android/iOS).
#
# Authorized JavaScript origins (no trailing slash, no path):
#   http://localhost:5174
#   http://127.0.0.1:5174
#   https://serene-pink-pi.vercel.app
# If testing on phone over Wi‑Fi, also add your PC LAN origin, e.g.:
#   http://192.168.1.42:5173
#
# OAuth consent screen: add test users while app is in "Testing" mode.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Convex backend — deployment URL from dashboard (Settings → Deployments)
# Do NOT put CONVEX_DEPLOY_KEY here; keep deploy keys in .env.local only.
VITE_CONVEX_URL=https://your-deployment.convex.cloud
